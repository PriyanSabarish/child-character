{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CharacterRigManifest",
  "type": "object",
  "required": ["version", "rig_id", "canvas", "base", "slots", "sprites", "idle"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "rig_id": { "type": "string" },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 128 },
        "height": { "type": "integer", "minimum": 128 }
      },
      "additionalProperties": false
    },
    "base": { "type": "string" },
    "slots": {
      "type": "object",
      "required": ["mouth", "eyes"],
      "properties": {
        "mouth": {
          "type": "object",
          "required": ["x", "y", "anchor"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "anchor": { "type": "string", "enum": ["top-center", "center"] }
          },
          "additionalProperties": false
        },
        "eyes": {
          "type": "object",
          "required": ["x", "y", "anchor"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "anchor": { "type": "string", "enum": ["top-center", "center"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sprites": {
      "type": "object",
      "required": ["mouth", "eyes"],
      "properties": {
        "mouth": {
          "type": "object",
          "required": ["closed", "small", "medium", "wide"],
          "properties": {
            "closed": { "type": "string" },
            "small": { "type": "string" },
            "medium": { "type": "string" },
            "wide": { "type": "string" }
          },
          "additionalProperties": false
        },
        "eyes": {
          "type": "object",
          "required": ["open", "blink"],
          "properties": {
            "open": { "type": "string" },
            "blink": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "idle": {
      "type": "object",
      "required": ["sway_amplitude_px", "sway_period_ms", "blink_interval_ms", "blink_duration_ms"],
      "properties": {
        "sway_amplitude_px": { "type": "number" },
        "sway_period_ms": { "type": "integer", "minimum": 100 },
        "blink_interval_ms": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        },
        "blink_duration_ms": { "type": "integer", "minimum": 10 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}